# ---------------------------------------------------------------------------
# Scoot — copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Supabase connection for the deployed API — Session pooler, port 5432, with
# the database password in it. Used by the deploy steps in docs/deploy.md
# (migrations, seed, and creating the Hyperdrive config) and read straight from
# this file so the password never has to be pasted into a command.
# Transaction pooler (port 6543) will NOT work: Drizzle migrations need session
# mode. Leave empty for local development.
SUPABASE_DB_URL=

# Local docker-compose default. To move to Supabase, change ONLY this line —
# every query goes through Drizzle + the repository layer, so no code changes.
DATABASE_URL=postgres://scoot:scoot@localhost:5432/scoot

# --- API ------------------------------------------------------------------
# Port the Hono API listens on.
API_PORT=8787
# Node environment. `development` enables /dev/simulate/* endpoints and the
# fixed OTP bypass below. Set to `production` to disable both.
NODE_ENV=development
# HMAC secret for signing JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000
# How long an access token stays valid.
JWT_EXPIRES_IN=30d

# --- Telegram login ---------------------------------------------------------
# Bot token from @BotFather. Unset = /auth/telegram/* endpoints answer 501.
TELEGRAM_BOT_TOKEN=
# Bot username for the native app's t.me deep link (no @).
TELEGRAM_BOT_USERNAME=Scootrentuzbot
# Shared secret for the bot webhook (min 16 chars): openssl rand -hex 16
# One-time setup after deploy:
#   curl "https://api.telegram.org/bot$TOKEN/setWebhook" \
#     -d "url=https://<api-host>/telegram/webhook" -d "secret_token=$SECRET"
TELEGRAM_WEBHOOK_SECRET=

# Force dev affordances (the fixed OTP bypass, /dev/simulate/*) regardless of
# NODE_ENV. The pre-release deployment runs NODE_ENV=production with
# DEV_FEATURES=true so the demo controls stay reachable.
DEV_FEATURES=
# Guards /dev/simulate/* on a deployed instance, sent as X-Dev-Secret.
# Generate with: openssl rand -hex 24
# Leave empty locally. In production, empty = those routes are disabled, so a
# deploy cannot leave "start a ride on any scooter" open to whoever finds it.
DEV_ROUTES_SECRET=

# Pre-fills the mini app's phone field so a demo does not start with typing.
# Optional and local-only — never commit a real number, that is what put one in
# the public repo before.
VITE_DEMO_PHONE=

# --- Dev auth -------------------------------------------------------------
# A fixed six-digit code accepted INSTEAD of a real SMS, and only for the
# numbers listed in OTP_BYPASS_PHONES below. Everyone else gets a real code
# over Eskiz, so this is a demo convenience rather than a way in.
#
# It is still a working credential for those numbers, so on a DEPLOYED instance
# it is a Wrangler *secret*, not a var in the public wrangler.jsonc, and the
# API refuses to start without one rather than falling back to the default.
DEV_OTP_CODE=000000
# Comma-separated E.164 numbers that may use DEV_OTP_CODE instead of waiting
# for an SMS — your own phone, so a rehearsed demo never depends on a carrier.
# EMPTY = nobody bypasses, which is the safe default.
#
# NOTE the direction, because it is the opposite of the old OTP_TEST_PHONES:
# that was an ALLOWLIST deciding who could sign in at all, back when a fixed
# code and no SMS provider meant an open door. Now everyone can sign in, and
# this list only says who may skip the SMS. env.ts refuses to start if the old
# name is still set, rather than silently applying the opposite policy.
#
# On a deployed instance this is a secret: it holds real personal numbers.
OTP_BYPASS_PHONES=

# --- SMS (Eskiz) ----------------------------------------------------------
# Which SmsGateway is live: `console` writes the code to the log, `eskiz` sends
# a real SMS. Unset = `eskiz` when the credentials below are set, else
# `console`, so local development never spends provider credit by accident.
SMS_GATEWAY=console
# From the "СМС шлюз" tab at https://my.eskiz.uz/sms/settings. The secret key
# is a credential — a Wrangler *secret* on a deployed instance, never a var.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Sender id ("alpha name"). 4546 is Eskiz's shared default; a branded sender
# has to be requested from them and needs a signed contract.
ESKIZ_FROM=4546

# --- Google sign-in -------------------------------------------------------
# Comma-separated OAuth client ids (iOS, Android, Web) accepted as an ID
# token's `aud`. Client ids are PUBLIC — the confidential half of an OAuth
# client never reaches a mobile app — so these are vars, not secrets.
# Empty = POST /auth/google answers 501.
GOOGLE_CLIENT_IDS=
# The same two ids the rider app needs at build time. The web client id is what
# an Android ID token carries as `aud`, so it is required even with no web app.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# --- Fleet simulator (Checkpoint 2) --------------------------------------
# Tick interval in ms for the simulated fleet loop.
SIMULATOR_TICK_MS=3000
# Probability (0..1) that an unlock command fails, so the retry/error UI is
# demonstrable. 0.08 = 8%.
SIMULATOR_UNLOCK_FAILURE_RATE=0.08
# Which VehicleGateway implementation to use: `simulated` | `iot`.
# `iot` is a phase-2 stub and throws NotImplementedError.
VEHICLE_GATEWAY=simulated

# --- Admin panel (Checkpoint 5) ------------------------------------------
# Base URL the admin panel calls. Vite only exposes VITE_-prefixed vars.
VITE_API_URL=http://localhost:8787

# --- Mobile app (Checkpoint 4) -------------------------------------------
# Base URL the rider app calls. Must be reachable from the phone, so use your
# machine's LAN IP (e.g. http://192.168.1.20:8787), not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Set to 1 to keep the demo controls (simulate scan, step into parking zone)
# in a release/TestFlight build, where __DEV__ is false. Baked at build time.
# Leave empty for a real store build.
EXPO_PUBLIC_DEMO_CONTROLS=
