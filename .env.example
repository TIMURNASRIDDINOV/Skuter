# ---------------------------------------------------------------------------
# Scoot — copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Supabase connection for the deployed API — Session pooler, port 5432, with
# the database password in it. Used by the deploy steps in docs/deploy.md
# (migrations, seed, and creating the Hyperdrive config) and read straight from
# this file so the password never has to be pasted into a command.
# Transaction pooler (port 6543) will NOT work: Drizzle migrations need session
# mode. Leave empty for local development.
SUPABASE_DB_URL=

# Local docker-compose default. To move to Supabase, change ONLY this line —
# every query goes through Drizzle + the repository layer, so no code changes.
DATABASE_URL=postgres://scoot:scoot@localhost:5432/scoot

# --- API ------------------------------------------------------------------
# Port the Hono API listens on.
API_PORT=8787
# Node environment. `development` enables /dev/simulate/* endpoints and the
# fixed OTP below. Set to `production` to disable both.
NODE_ENV=development
# HMAC secret for signing JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000
# How long an access token stays valid.
JWT_EXPIRES_IN=30d

# --- Telegram login ---------------------------------------------------------
# Bot token from @BotFather. Unset = /auth/telegram/* endpoints answer 501.
TELEGRAM_BOT_TOKEN=
# Bot username for the native app's t.me deep link (no @).
TELEGRAM_BOT_USERNAME=Scootrentuzbot
# Shared secret for the bot webhook (min 16 chars): openssl rand -hex 16
# One-time setup after deploy:
#   curl "https://api.telegram.org/bot$TOKEN/setWebhook" \
#     -d "url=https://<api-host>/telegram/webhook" -d "secret_token=$SECRET"
TELEGRAM_WEBHOOK_SECRET=

# Force dev affordances (fixed OTP code, /dev/simulate/*) regardless of
# NODE_ENV. The pre-release deployment runs NODE_ENV=production with
# DEV_FEATURES=true because there is no SMS provider yet.
DEV_FEATURES=
# Guards /dev/simulate/* on a deployed instance, sent as X-Dev-Secret.
# Generate with: openssl rand -hex 24
# Leave empty locally. In production, empty = those routes are disabled, so a
# deploy cannot leave "start a ride on any scooter" open to whoever finds it.
DEV_ROUTES_SECRET=

# --- Dev auth -------------------------------------------------------------
# In development, phone OTP verification accepts this fixed code so the demo
# never depends on an SMS provider. Ignored when NODE_ENV=production.
DEV_OTP_CODE=000000
# Comma-separated E.164 allowlist. Non-empty = ONLY these numbers can sign in
# (403 for everyone else) — for test builds circulating before the SMS
# provider exists. Leave empty for normal behaviour (any +998 number).
OTP_TEST_PHONES=

# --- Fleet simulator (Checkpoint 2) --------------------------------------
# Tick interval in ms for the simulated fleet loop.
SIMULATOR_TICK_MS=3000
# Probability (0..1) that an unlock command fails, so the retry/error UI is
# demonstrable. 0.08 = 8%.
SIMULATOR_UNLOCK_FAILURE_RATE=0.08
# Which VehicleGateway implementation to use: `simulated` | `iot`.
# `iot` is a phase-2 stub and throws NotImplementedError.
VEHICLE_GATEWAY=simulated

# --- Admin panel (Checkpoint 5) ------------------------------------------
# Base URL the admin panel calls. Vite only exposes VITE_-prefixed vars.
VITE_API_URL=http://localhost:8787

# --- Mobile app (Checkpoint 4) -------------------------------------------
# Base URL the rider app calls. Must be reachable from the phone, so use your
# machine's LAN IP (e.g. http://192.168.1.20:8787), not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787
# Set to 1 to keep the demo controls (simulate scan, step into parking zone)
# in a release/TestFlight build, where __DEV__ is false. Baked at build time.
# Leave empty for a real store build.
EXPO_PUBLIC_DEMO_CONTROLS=
