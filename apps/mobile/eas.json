{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://scoot-api.timurnasriddinov56.workers.dev",
        "EXPO_PUBLIC_DEMO_CONTROLS": "1"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "apk": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://scoot-api.timurnasriddinov56.workers.dev",
        "EXPO_PUBLIC_DEMO_CONTROLS": "1"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "testflight": {}
  }
}
